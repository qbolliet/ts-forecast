        <mxCell id="c40" value="&lt;b&gt;Cas inverse&lt;/b&gt; : délai 'start' de 135 jours → délai 'end'&lt;br&gt;Publication = 1er janvier + 135 jours = 15 mai ; délai = 15 mai − 1er avril = 44 jours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=0;fontColor=#000000;align=left;verticalAlign=middle;dashed=0;strokeWidth=1;spacing=12;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="604" width="740" height="76" as="geometry" /></mxCell>
        <mxCell id="c41" value="&lt;b&gt;Point important&lt;/b&gt; : la conversion ne change pas la date de publication, seulement l'origine du délai. 44 jours après la fin du T1 équivalent à 135 jours après son début (T1 de 91 jours)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=0;fontColor=#000000;align=left;verticalAlign=middle;dashed=0;strokeWidth=1;spacing=12;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="692" width="740" height="76" as="geometry" /></mxCell>
