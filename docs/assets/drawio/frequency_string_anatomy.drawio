        <mxCell id="c14" value="&lt;b&gt;Ancre&lt;/b&gt;&lt;br&gt;mois de début (S) ou de fin (E) d'un trimestre ou d'une année ; jour de fin d'une semaine (W-WED)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=0;fontColor=#000000;align=left;verticalAlign=top;dashed=0;strokeWidth=1;spacing=10;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="178" height="136" as="geometry" /></mxCell>
