        <mxCell id="c25" value="ParsedFrequency(freq='Q', position='S', suffix='FEB', multiplier=2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;fontStyle=0;fontColor=#000000;align=left;verticalAlign=middle;dashed=0;strokeWidth=1;spacing=8;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="162" y="448" width="586" height="30" as="geometry" /></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Code du paquet et alias pandas&lt;/b&gt; : une base nue ('M', 'Q', 'Y', 'SM') est un code du paquet, que pandas 3 refuse comme alias. Avant tout appel à pandas, to_pandas_freq('Q') donne 'QE', comme build_frequency_string('Q', default_position='E')." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=0;fontColor=#000000;align=left;verticalAlign=middle;dashed=0;strokeWidth=1;spacing=12;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="498" width="740" height="82" as="geometry" /></mxCell>
