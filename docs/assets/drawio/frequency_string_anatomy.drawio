        <mxCell id="c10" value="" style="html=1;endArrow=none;startArrow=none;endFill=1;startFill=1;strokeColor=#82b366;strokeWidth=2;dashed=0;endSize=8;startSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="473" y="124" as="sourcePoint" /><mxPoint x="473" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Position&lt;/b&gt;&lt;br&gt;S (début) ou E (fin) de la période, pour M, Q, Y et SM seulement. Ne change pas la période." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=0;fontColor=#000000;align=left;verticalAlign=top;dashed=0;strokeWidth=1;spacing=10;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="384" y="140" width="178" height="136" as="geometry" /></mxCell>
