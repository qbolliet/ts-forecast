        <mxCell id="c5" value="&lt;b&gt;Multiplicateur&lt;/b&gt;&lt;br&gt;facultatif (défaut 1) : nombre de périodes de base par pas. '2QS-FEB' avance de deux trimestres." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=0;fontColor=#000000;align=left;verticalAlign=top;dashed=0;strokeWidth=1;spacing=10;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="12" y="140" width="178" height="136" as="geometry" /></mxCell>
