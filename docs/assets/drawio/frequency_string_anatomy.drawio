        <mxCell id="c8" value="&lt;b&gt;Base&lt;/b&gt;&lt;br&gt;ns, us, ms, s, min, h, D, B, W, SM, M, Q, Y. Les noms 'monthly', 'quarterly', ... sont acceptés." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=0;fontColor=#000000;align=left;verticalAlign=top;dashed=0;strokeWidth=1;spacing=10;absoluteArcSize=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="198" y="140" width="178" height="136" as="geometry" /></mxCell>
