        <mxCell id="c60" value="Légende" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="26" y="1064" width="200" height="20" as="geometry" /></mxCell>
